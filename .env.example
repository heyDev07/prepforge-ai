# =============================================================================
# PrepForge AI — environment configuration
# Copy to .env and fill in the values marked REQUIRED.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM provider
# -----------------------------------------------------------------------------
# gemini | openai | mock   (mock = deterministic offline replies, used by tests and demos)
# Gemini is the default and the provider this project was built and tested with (free tier).
LLM_PROVIDER=gemini

# Google Gemini (REQUIRED key when LLM_PROVIDER=gemini): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# OpenAI (REQUIRED key when LLM_PROVIDER=openai; paid)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: any OpenAI-compatible endpoint (leave empty for api.openai.com)
LLM_BASE_URL=

# Optional: overrides the model for whichever provider is selected
LLM_MODEL=

# Rate limiting / reliability for LLM calls
LLM_MAX_CONCURRENCY=2
# Gemini's free tier allows 15 requests per minute
LLM_REQUESTS_PER_MINUTE=15
LLM_MAX_RETRIES=4
LLM_TIMEOUT_MS=60000

# -----------------------------------------------------------------------------
# Public interview research
# -----------------------------------------------------------------------------
# tavily = Tavily web search (needs TAVILY_API_KEY; free tier: 1,000 credits/month)
# hn     = Hacker News Algolia public API (no key needed)
# brave  = Brave Search API (needs BRAVE_API_KEY)
# none   = skip public research
# Without the key for the chosen provider, the keyless Hacker News search is used.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=

# -----------------------------------------------------------------------------
# Company website crawler
# -----------------------------------------------------------------------------
MAX_PAGES=12
MAX_DEPTH=2
REQUEST_TIMEOUT_MS=10000
MAX_PAGE_BYTES=1000000
MAX_CONCURRENCY=2
MAX_RETRIES=3
# Minimum delay between requests to one company site (robots.txt Crawl-delay wins)
CRAWL_DELAY_MS=200
# Allow localhost / private-network URLs. Keep false for the web app.
# The batch evaluator always enables this for local test servers.
ALLOW_PRIVATE_URLS=false
CRAWLER_USER_AGENT=PrepForgeBot/1.0 (+https://github.com/heyDev07/prepforge-ai)

# -----------------------------------------------------------------------------
# Pipeline
# -----------------------------------------------------------------------------
MAX_COVERAGE_PASSES=3
# Batch evaluator: cases processed in parallel, and per-case time budget
BATCH_CONCURRENCY=2
CASE_TIMEOUT_MS=480000

# -----------------------------------------------------------------------------
# API server
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/prepforge
SESSION_TTL_DAYS=7
# true in production (HTTPS)
COOKIE_SECURE=false
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
GENERATION_CONCURRENCY=1
# Proxy hops to trust for client IPs (set 1 behind a load balancer / PaaS router)
TRUST_PROXY=0
# Max login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT=20

# -----------------------------------------------------------------------------
# Web app
# -----------------------------------------------------------------------------
# Where the Next.js app proxies /api/* requests. Read when the web app is BUILT
# (next build), so set it before building for a deployment.
API_URL=http://localhost:4000
