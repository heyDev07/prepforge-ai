# =============================================================================
# PrepForge AI — environment configuration
# Copy to .env and fill in the values marked REQUIRED.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM provider
# -----------------------------------------------------------------------------
# openai | gemini | mock   (mock = scripted responses, used by tests)
LLM_PROVIDER=openai
# REQUIRED when LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
# Optional: any OpenAI-compatible endpoint (leave empty for api.openai.com)
LLM_BASE_URL=
# Only needed when LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Rate limiting / reliability for LLM calls
LLM_MAX_CONCURRENCY=2
LLM_REQUESTS_PER_MINUTE=60
LLM_MAX_RETRIES=4
LLM_TIMEOUT_MS=60000

# -----------------------------------------------------------------------------
# Public interview research
# -----------------------------------------------------------------------------
# hn    = Hacker News Algolia public API (no key needed)
# brave = Brave Search API (needs BRAVE_API_KEY)
# none  = skip public research
SEARCH_PROVIDER=hn
BRAVE_API_KEY=

# -----------------------------------------------------------------------------
# Company website crawler
# -----------------------------------------------------------------------------
MAX_PAGES=12
MAX_DEPTH=2
REQUEST_TIMEOUT_MS=10000
MAX_PAGE_BYTES=1000000
MAX_CONCURRENCY=2
MAX_RETRIES=3
# Minimum delay between requests to one company site (robots.txt Crawl-delay wins)
CRAWL_DELAY_MS=200
# Allow localhost / private-network URLs. Keep false for the web app.
# The batch evaluator always enables this for local test servers.
ALLOW_PRIVATE_URLS=false
CRAWLER_USER_AGENT=PrepForgeBot/1.0 (+https://github.com/heyDev07/prepforge-ai)

# -----------------------------------------------------------------------------
# Pipeline
# -----------------------------------------------------------------------------
MAX_COVERAGE_PASSES=3
# Batch evaluator: cases processed in parallel, and per-case time budget
BATCH_CONCURRENCY=2
CASE_TIMEOUT_MS=480000

# -----------------------------------------------------------------------------
# API server
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/prepforge
SESSION_TTL_DAYS=7
# true in production (HTTPS)
COOKIE_SECURE=false
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
GENERATION_CONCURRENCY=1

# -----------------------------------------------------------------------------
# Web app
# -----------------------------------------------------------------------------
# Where the Next.js server proxies /api/* requests
API_URL=http://localhost:4000
